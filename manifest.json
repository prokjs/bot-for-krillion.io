{
  "manifest_version": 3,
  "name": "Krillion Deep Cuts",
  "version": "1.0.0",
  "description": "Reads visible Krillion prompts and explains obscure answer suggestions.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.openai.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "action": { "default_title": "Configure Krillion Deep Cuts" },
  "content_scripts": [{
    "matches": ["https://krillion.io/*", "https://www.krillion.io/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
